{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atlas OS",
  "version": "../package.json",
  "identifier": "com.opencode-os.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Atlas OS",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "visible": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:* ws://127.0.0.1:* http://localhost:* http://127.0.0.1:* https://*; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "deb", "rpm", "appimage", "dmg"],
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/icon.icns"],
    "resources": ["../skills/"],
    "copyright": "2026 Atlas OS Authors",
    "category": "DeveloperTool",
    "shortDescription": "Agent Engineering Operating System.",
    "longDescription": "Multi-agent, multi-model programming editor with auto-routing, swarm orchestration, and HUD Mission Control."
  }
}
